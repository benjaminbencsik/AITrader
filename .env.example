# Copy to .env and fill in. Never commit .env.
APP_PASSWORD=choose-a-long-passphrase     # required, 8+ characters
HOST=127.0.0.1                            # 0.0.0.0 only behind HTTPS (reverse proxy / tunnel)
PORT=8080

# Market data + Alpaca (free account at alpaca.markets). Without keys the app runs on synthetic demo data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true                         # true = Alpaca's own paper account, false = REAL MONEY

# AI trade review (console.anthropic.com). Optional; without it trades follow the rules only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Hard cap per live order, enforced on the server whatever the settings say.
MAX_LIVE_TRADE_DOLLARS=10

# Schwab (experimental, untested)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=

# ---- Added features ----
# Earnings dates (free key at finnhub.io). Without it the earnings rule can't run.
FINNHUB_API_KEY=
# Phone alerts: install the free ntfy app, subscribe to a long random topic name, put the same name here.
# Needed for Robinhood: signals arrive here and you place the order in Robinhood yourself.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Dead-man's switch: a healthchecks.io ping URL, called after every good scan.
HEALTHCHECK_URL=
# Schwab (experimental, untested). Register this redirect in your Schwab developer app, then Settings -> Connect Schwab.
SCHWAB_REDIRECT_URI=https://your-server.example.com/oauth/schwab/callback
# Webull (experimental, untested). Sandbox keys are approved automatically.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_SANDBOX=true
WEBULL_ACCOUNT_ID=

# ---- More stock brokers (all untested; sandboxes first) ----
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
TRADIER_SANDBOX=true                      # false = REAL MONEY
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ACCOUNT=
TASTYTRADE_SANDBOX=true                   # false = REAL MONEY
PUBLIC_API_SECRET=                        # no sandbox: REAL MONEY
PUBLIC_ACCOUNT_ID=
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=

# ---- Crypto brokers (all untested; REAL MONEY unless noted). Use keys with trade permission and NO withdrawal permission. ----
ROBINHOOD_API_KEY=                        # Robinhood web classic -> Settings -> Crypto -> API trading
ROBINHOOD_PRIVATE_KEY=                    # base64 Ed25519 private key
COINBASE_API_KEY_NAME=                    # organizations/.../apiKeys/...
COINBASE_API_PRIVATE_KEY=                 # the PEM, newlines written as \n
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_DEMO=true                             # true = OKX demo trading with demo keys; false = REAL MONEY
OKX_QUOTE=USDT

# ---- GitHub mode (set these as repository Secrets / Variables, not in a file; see SETUP-GITHUB.md) ----
# STATE_PASSPHRASE=                       # required: encrypts everything stored in the repo
# NTFY_DISPATCH_TOKEN=                    # optional: token (Actions: write only) that powers the Pause / Sell everything phone buttons
